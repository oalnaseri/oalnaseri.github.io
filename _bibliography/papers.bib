@article{alnaseri2025cyclic,
  abbr={IEEE},
  title={Cyclic Shift Phase Rotation: An Innovative, Low-Complexity Technique for PAPR Reduction},
  abstract={This paper presents cyclic shift phase rotation (CSPR), an innovative technique designed to mitigate the peak-to-average power ratio (PAPR) in coherent optical orthogonal frequency division multiplexing (CO-OFDM) systems. CSPR demonstrates notable improvements when compared to traditional techniques, such as discrete Fourier transform spread (DFT-spread) and selective mapping (SLM). CSPR eliminates the need for side information, additional inverse fast Fourier transforms (IFFTs), and complex search processes that are needed by other techniques. Analytical evaluations confirm that CSPR requires $O(N \log C_0)$ operations, which is significantly lower than the $O(M\cdot N \log N)$ complexity of SLM and the $O(L \cdot n \log n)$ complexity of DFT-spread. The CSPR has been evaluated within the CO-OFDM transmission. At a distance of 800 km, CSPR facilitates a 3 dB reduction in the required optical signal-to-noise ratio (OSNR) necessary for achieving hard-decision forward error correction (H-FEC) when compared to DFT-spread utilizing 112 sub-bands, and it exceeds the performance of the SLM at low OSNR with the use of 64 candidates. Moreover, it exhibits an 8 dB enhancement in the Q-factor over transmission distances extending up to 2000 km under nonlinear conditions. These results position CSPR as an effective and efficient solution for PAPR mitigation, significantly improving system performance, and reducing hardware complexity.},
  author={Alnaseri, Omar and Alzubaidi, Laith and Timmermann, Jens},
  journal={IEEE Transactions on Communications},
  year={2025},
  doi={https://doi.org/10.1109/TCOMM.2025.3591168},
  url={https://ieeexplore.ieee.org/abstract/document/11087608},
  bibtex_show={true},
  dimensions={true},
  google_scholar_id={UxriW0iASnsC},
  pdf={TCOMM3591168_IEEE_AcceptedVersion.pdf}
}

@article{titouni2025hybrid,
  abbr={IEEE},
  title={Hybrid CNN-Ensemble Framework for Intelligent Optical Fiber Fault Detection and Diagnosis},
  author={Titouni, Salem and Messaoudene, Idris and Himeur, Yassine and Alnaseri, Omar and Chetouah, Farouk and Hammache, Boualem and Belazzoug, Massinissa and Atalla, Shadi and Mansoor, Wathiq},
  abstract={Ensuring the integrity and reliability of optical fiber networks is essential for modern global communication systems, as faults such as fiber cuts, malicious tapping, and connector degradation can result in significant service disruptions and security vulnerabilities. Traditional fault detection methods, such as optical time-domain reflectometry (OTDR), face challenges due to noisy signals, signal attenuation, and reliance on expert interpretation. Additionally, existing machine learning approaches often struggle with generalization across diverse fault types and imbalanced datasets. This paper introduces a novel Hybrid CNN-Ensemble framework, combining convolutional neural networks (CNNs) for deep feature extraction with ensemble learning techniques including XGBoost, Support Vector Machines (SVM), and Random Forest (RF). The framework processes CNN-extracted features from OTDR traces, with predictions aggregated through a meta-classifier. Validated on a comprehensive OTDR dataset covering eight distinct fault categories, the proposed method achieves 99.5% accuracy and an F1-score of 0.99, offering exceptional precision in detecting and classifying fiber faults. The results demonstrate the framework’s ability to improve fault detection performance, streamline fiber monitoring processes, reduce operational costs, and enhance network resilience to both physical attacks and accidental failures.},
  journal={IEEE Open Journal of the Communications Society},
  year={2025},
  doi={https://doi.org/10.1109/FNWF63303.2024.11028865},
  url={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11028865},
  bibtex_show={true},
  dimensions={true},
  google_scholar_id={nb7KW1ujOQ8C}
}

@article{alnaseri2025Nakagami,
  abbr={IEEE},
  title={End-to-End Learning-Enabled Wireless Links in Cyber-Physical Systems: a Study on Nakagami Fading Effects},
  author={Alnaseri, Omar and Himeur, Yassine and Atalla, Shadi and Alkhazaleh, Hamzah and Mansoor, Wathiq},
  abstract={Cyber-physical systems (CPS) need fast and reliable wireless communication to keep computational and physical components working together in real time. However, wireless links in CPS are significantly affected by fading phenomena that introduce signal degradation and cause performance fluctuations. In this work, we investigate the integration of end-to-end deep learning-based communication architectures in CPS, specifically in the presence of Nakagami-m fading. We analyze key wireless communication metrics, including bit error rate (BER) and achievable information rate (AIR), under varying transmission distances, path loss exponents, and Nakagami fading parameters. Our findings demonstrate that deep learning-based autoencoders can effectively mitigate fading-induced performance degradation. The simulation results show that at 25 dB SNR, the BER is just $4.15 \times 10^{-5}$ for a short 300 m transmission. But when the distance stretches to 1 km, the BER jumps to $2 \times 10^{-3}$ which demonstrates just how much path loss and fading affect communication performance. This reflects that the proposed approach is effective even in harsh fading conditions and over long distances, which confirm that it is a robust alternative to traditional wireless communication techniques, particularly in difficult fading environments. This research brings us one step closer to making wireless CPS more reliable, intelligent, and adaptable, paving the way for better communication in industrial automation, smart infrastructure, and vehicular networks.},
  journal={accepted for publication in the 2025 International Conference on Communication, Computing, Networking, and Control in Cyber-Physical Systems (CCNCPS)},
  year={2025},
  doi={},
  url={https://www.ccncps.net/},
  bibtex_show={true},
  dimensions={true},
  google_scholar_id={}
}

@article{alnaseri2025post,
  abbr={IEEE},
  title={Complexity of Post-Quantum Cryptography in Embedded Systems and Its Optimization Strategies},
  author={Alnaseri, Omar and Himeur, Yassine and Atalla, Shadi and Mansoor, Wathiq},
  abstract={With the rapid advancements in quantum computing, traditional cryptographic schemes like RSA and eECC are becoming vulnerable, necessitating the development of quantum-resistant algorithms. The NIST has initiated a standardization process for PQC algorithms, and several candidates, including CRYSTALS Kyber and McEliece, have reached the final stages. This paper first provides a comprehensive analysis of the hardware complexity of PQC in embedded systems, categorizing PQC algorithms into families based on their underlying mathematical problems: lattice-based, code-based, hash-based and multivariate isogeny-based schemes. Each family presents distinct computational, memory, and energy profiles, making them suitable for different use cases. To address these challenges, this paper discusses optimization strategies such as pipelining, parallelization, and HLS, which can improve the performance and energy efficiency of PQC implementations. Finally, a detailed complexity analysis of CRYSTALS-Kyber and McEliece, comparing their key generation, encryption, and decryption processes in terms of computational complexity, has been conducted.},
  journal={accepted for publication in the IWCMC, Abu Dhabi, UAE},
  year={2025},
  doi={},
  url={https://iwcmc.net/2025/index.php},
  bibtex_show={true},
  dimensions={true},
  google_scholar_id={P5F9QuxV20EC}
}

@article{yassine2025Federated,
  abbr={IEEE},
  title={Federated Large Language Models for Wireless Networks},
  author={Himeur, Yassine and Dawoud, Diana and Alnaseri, Omar and Atalla, Shadi and Mansoor, Wathiq},
  abstract={This paper examines the role of Federated Large Language Models (FLLMs) in enhancing privacy preserving AI and intelligent network management for 5G/6G wireless networks. FLLMs leverage federated learning to train AI models at the edge while safeguarding user data and complying with privacy regulations. Key challenges addressed include communication efficiency, security, and model adaptability. The study explores FLLMs’ impact on network optimization, intelligent resource allocation, real-time decision-making, cybersecurity, and anomaly detection. Future directions include integrating FLLMs with Digital Twins, Explainable AI, and blockchainbased security. This research provides a roadmap for deploying FLLMs in secure, AI-driven wireless networks, bridging AI and federated learning for next-generation communication.},
  journal={accepted for publication in the IWCMC, Abu Dhabi, UAE},
